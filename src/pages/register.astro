---
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/common/Header.astro";
import Footer from "@/components/common/Footer.astro";
import RegistrationCards from "@/components/common/RegistrationCards.astro";
import ButtonLink from "@/components/ui/ButtonLink.astro";
import { Clock, ExternalLink } from "lucide-react";
import { isRegistrationOpen } from "@/lib/site-config";
---

<Layout
  title="Registro | Ethereum Bolivia"
  description={isRegistrationOpen
    ? "Elige cómo participar: inscríbete como hacker, speaker o voluntario en Ethereum Bolivia."
    : "Consulta el estado de las inscripciones de Ethereum Bolivia."}
>
  <div class="relative flex min-h-screen w-full flex-col">
    <div class="layout-container flex h-full grow flex-col">
      <Header />
      <main class="flex flex-col flex-1">
        <section class="w-full py-24 px-4 bg-background">
          <div
            class:list={[
              "mx-auto flex flex-col items-center text-center",
              isRegistrationOpen ? "max-w-6xl" : "max-w-xl",
            ]}
          >
            {
              isRegistrationOpen ? (
                <>
                  <div class="flex h-14 w-14 shrink-0 items-center justify-center rounded-full bg-muted border border-border mb-6">
                    <ExternalLink className="size-7 text-muted-foreground" />
                  </div>
                  <h1 class="text-3xl font-bold text-foreground tracking-tight mb-4">
                    Elige cómo participar
                  </h1>
                  <p class="text-muted-foreground text-base font-light mb-10 max-w-md">
                    Inscríbete como hacker, speaker o voluntario. Cada rol abre
                    su formulario en una nueva pestaña.
                  </p>
                  <RegistrationCards />
                  <div class="mt-10 flex flex-col justify-center gap-4 sm:flex-row">
                    <ButtonLink
                      href="https://t.me/EthereumBo"
                      rel="noopener noreferrer"
                      target="_blank"
                      size="lg"
                      variant="secondary"
                      className="rounded-full"
                    >
                      Mantente en contacto
                    </ButtonLink>
                    <ButtonLink
                      href="/road-to-buildathon/"
                      size="lg"
                      variant="outline"
                      className="rounded-full"
                    >
                      Road To Buildathon
                    </ButtonLink>
                    <ButtonLink
                      href="/"
                      size="lg"
                      variant="outline"
                      className="rounded-full"
                    >
                      Volver al inicio
                    </ButtonLink>
                  </div>
                </>
              ) : (
                <>
                  <div class="flex h-14 w-14 shrink-0 items-center justify-center rounded-full bg-muted border border-border mb-6">
                    <Clock className="size-7 text-muted-foreground" />
                  </div>
                  <h1 class="text-3xl font-bold text-foreground tracking-tight mb-4">
                    Las inscripciones aún no están abiertas
                  </h1>
                  <p class="text-muted-foreground text-base font-light mb-8 max-w-md">
                    Te avisaremos cuando puedas inscribirte. Mantente atento a
                    nuestras redes.
                  </p>
                  <div class="flex flex-col sm:flex-row gap-4 justify-center">
                    <ButtonLink
                      href="https://t.me/EthereumBo"
                      rel="noopener noreferrer"
                      target="_blank"
                      size="lg"
                      variant="secondary"
                      className="rounded-full"
                    >
                      Mantente en contacto
                    </ButtonLink>
                    <ButtonLink
                      href="/"
                      size="lg"
                      variant="outline"
                      className="rounded-full"
                    >
                      Volver al inicio
                    </ButtonLink>
                    <ButtonLink
                      href="/road-to-buildathon/"
                      size="lg"
                      variant="outline"
                      className="rounded-full"
                    >
                      Road To Buildathon
                    </ButtonLink>
                  </div>
                </>
              )
            }
          </div>
        </section>
      </main>
      <Footer />
    </div>
  </div>
</Layout>
