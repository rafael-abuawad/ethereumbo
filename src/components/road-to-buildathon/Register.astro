---
import ButtonLink from "@/components/ui/ButtonLink.astro";
---

<section class="w-full py-16 px-4 bg-muted border-t border-border">
  <div class="max-w-xl mx-auto text-center">
    <h2 class="text-2xl font-semibold text-foreground mb-4">
      ¿Listo para empezar?
    </h2>
    <p class="text-muted-foreground text-sm mb-8 font-light">
      Participa en las charlas y talleres que te ayudarán a llevar tu producto
      lo más cerca posible de producción.
    </p>
    <ButtonLink
      href="/register"
      size="lg"
      variant="outline"
      className="rounded-full w-full sm:w-auto px-8"
    >
      Regístrate en Road To Buildathon
    </ButtonLink>
    <p class="mt-4 text-xs text-muted-foreground opacity-60">
      *La inscripción al evento principal del Buildathon es aparte.
    </p>
  </div>
</section>
