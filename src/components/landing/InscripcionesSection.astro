---
import { ArrowRight, Rocket } from "lucide-react";
import { Card } from "@/components/ui/card";
import ButtonLink from "@/components/ui/ButtonLink.astro";
---

<section
  class="relative w-full bg-background py-24 md:py-28"
  id="inscripciones"
>
  <div class="max-w-[1280px] mx-auto px-6 lg:px-12 w-full relative">
    <div class="flex flex-col gap-4 mb-10 max-w-3xl">
      <h2
        class="font-display text-foreground text-4xl md:text-5xl lg:text-[3.25rem] font-semibold leading-tight tracking-tight text-left"
      >
        Inscripciones
      </h2>
      <p
        class="text-muted-foreground text-base md:text-lg leading-relaxed max-w-2xl"
      >
        Inscríbete al programa que te ayudará a convertir tu idea en un producto
        listo para el mundo real.
      </p>
    </div>
    <Card
      className="grid items-center gap-6 rounded-2xl border border-border/80 border-t-2 border-t-primary bg-card/90 p-6 shadow-none md:grid-cols-[auto_1fr_auto] md:p-8"
    >
      <div
        class="flex size-12 shrink-0 items-center justify-center rounded-xl bg-muted text-foreground ring-1 ring-border"
      >
        <Rocket className="size-6" />
      </div>
      <div class="flex flex-col gap-2">
        <h3 class="text-foreground text-xl font-bold leading-snug">
          Road To Buildathon
        </h3>
        <p class="text-muted-foreground max-w-2xl text-sm leading-relaxed">
          Una serie de charlas y talleres para llevar tu producto lo más cerca
          posible de producción.
        </p>
      </div>
      <ButtonLink
        href="/register"
        className="w-full rounded-full px-6 md:w-auto"
      >
        Inscríbete
        <ArrowRight className="size-4" />
      </ButtonLink>
    </Card>
  </div>
</section>
